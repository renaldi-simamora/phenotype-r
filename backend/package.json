  "description": "PHENONODE - IoT Multi-Sensor Backend API (Express.js + TypeScript + Supabase)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
