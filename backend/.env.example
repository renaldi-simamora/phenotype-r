PORT=8000
NODE_ENV=development
# official is the only valid production/research mode. demo is development-only UI content.
ASSESSMENT_MAPPING_MODE=official

# Supabase (ambil dari: Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret (harus sama dengan JWT Secret di Supabase Auth settings)
JWT_SECRET=your-supabase-jwt-secret

# ML Service (Python service terpisah, dipanggil server-to-server)
ML_SERVICE_URL=http://localhost:5000

# CORS - origin frontend
CORS_ORIGIN=http://localhost:3000
